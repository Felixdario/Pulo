# Infra local (docker compose)
DATABASE_URL=postgres://encurtador:encurtador@localhost:5433/encurtador
REDIS_URL=redis://localhost:6380

# Portas dos apps
REDIRECT_PORT=8080
API_PORT=3000
WEB_PORT=5173

# Segredo de exemplo; troque em qualquer ambiente real
JWT_SECRET=troque-este-segredo-de-exemplo-por-32-bytes-aleatorios

# Proxy reverso confiável (vazio = nenhum). Ex.: 127.0.0.1 ou 10.0.0.0/8
TRUST_PROXY=
# 1 aceita X-Forwarded-For sem proxy, só para testes locais
DEV_TRUST_XFF=0

LOG_LEVEL=info

# Redirect (ADR 0002). Segredo dos cookies de senha e das chaves de rate limit; vazio = JWT_SECRET.
REDIRECT_SECRET=
# Token bucket por visitante: capacidade e reposição por segundo
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL=10
# Só para medição: CACHE=off (sempre Postgres), RATE_LIMIT=off, REDIS_ROUNDTRIPS=2 (bucket e GET separados)
CACHE=on
RATE_LIMIT=on
REDIS_ROUNDTRIPS=1

# Geolocalização (DB-IP Lite, CC BY 4.0). Baixe com `corepack pnpm geo:download`; sem os arquivos,
# país e cidade ficam nulos e tudo segue funcionando.
GEO_CITY_MMDB=data/geo/dbip-city-lite.mmdb
GEO_COUNTRY_MMDB=data/geo/dbip-country-lite.mmdb

# Worker (ADR 0003)
WORKER_METRICS_PORT=9464
