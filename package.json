{
  "name": "encurtador",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "corepack pnpm -r --parallel --filter \"./apps/*\" dev",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench:redirect": "tsx scripts/bench-redirect.ts",
    "geo:download": "tsx scripts/geo-download.ts"
  },
  "devDependencies": {
    "@encurtador/db": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.20.5",
    "autocannon": "^9.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "ioredis": "^6.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
