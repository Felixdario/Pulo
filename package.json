{
  "name": "encurtador",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "corepack pnpm -r --parallel --filter \"./apps/*\" dev",
    "demo": "node scripts/demo.mjs",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test",
    "test:e2e": "corepack pnpm --filter @encurtador/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench:redirect": "tsx scripts/bench-redirect.ts",
    "geo:download": "tsx scripts/geo-download.ts",
    "seed:demo": "corepack pnpm --filter @encurtador/api seed:demo",
    "seed:big": "corepack pnpm --filter @encurtador/bench seed:big",
    "test:consistency": "corepack pnpm --filter @encurtador/bench test:consistency",
    "bench:analytics": "corepack pnpm --filter @encurtador/bench bench:analytics",
    "bench:write": "corepack pnpm --filter @encurtador/bench bench:write",
    "bench:trgm": "corepack pnpm --filter @encurtador/bench bench:trgm",
    "bench:retention": "corepack pnpm --filter @encurtador/bench bench:retention"
  },
  "devDependencies": {
    "@encurtador/db": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.20.5",
    "autocannon": "^9.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "ioredis": "^6.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
